<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F0F4F8;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fragmented.download.chatnew.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Chat Login" textFill="#333333">
        <font>
            <Font name="Arial Bold" size="24.0" />
        </font>
    </Label>

    <VBox spacing="5.0">
        <Label text="Server IP" />
        <TextField fx:id="ipField" promptText="e.g., 192.168.56.1" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Port" />
        <TextField fx:id="portField" promptText="e.g., 8080" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Username" />
        <TextField fx:id="usernameField" promptText="Enter your username" />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Password" />
        <PasswordField fx:id="passwordField" promptText="Enter your password" />
    </VBox>

    <Label fx:id="errorLabel" textFill="RED" visible="false">
        <font>
            <Font name="Arial" size="12.0" />
        </font>
    </Label>

    <VBox alignment="CENTER" spacing="10.0">
        <Button fx:id="loginButton" onAction="#onLoginButtonAction" text="Đăng nhập" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button fx:id="registerButton" onAction="#onRegisterButtonAction" text="Đăng ký" prefWidth="200" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </VBox>

</VBox>
